# Copy to .env and fill in. .env is git-ignored - never commit a real key.

# --- groq_app.py (recommended) ---
# Key from https://console.groq.com
GROQ_API_KEY=
# Optional. Default: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# --- app.py (local Hugging Face model, optional) ---
# MODEL_NAME=beomi/KoAlpaca-Polyglot-5.8B
# HUGGINGFACE_TOKEN=
